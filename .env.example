# Copy to .env for local runs outside Docker. docker-compose.yml sets its own values.
LOG_LEVEL=INFO
LOG_JSON=true

LLM_TIMEOUT_SECONDS=5.0
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=0.2

CONFIDENCE_THRESHOLD=0.6
TIMEZONE=Asia/Jakarta
MAX_CONTEXT_MESSAGES=10

# memory | mongo
REPOSITORY_BACKEND=memory
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=travelio
MONGO_COLLECTION=message_classifications
MONGO_REQUEST_LOG_COLLECTION=api_requests
